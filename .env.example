# Copy to .env and fill in. Every value here is safe to commit — real secrets
# belong in .env, which is ignored.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who opens the site. Never put a secret behind that prefix.

# ─── API ─────────────────────────────────────────────────────────────────────
# The Express backend as reached from the browser. Must match one of the
# origins in the backend's CORS_ORIGINS, or every request is blocked.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# The same API as reached from the Next.js server (server components, server
# actions, route handlers). Identical in development; in production this can be
# an internal address that never leaves the private network.
API_INTERNAL_URL=http://localhost:5000/api/v1

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin of the storefront. Feeds metadataBase, canonical URLs,
# hreflang alternates (en at /, de at /de/), sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Media ───────────────────────────────────────────────────────────────────
# Origin serving product images. With the backend on STORAGE_DRIVER=local this
# is the API itself, which serves /media/...; on STORAGE_DRIVER=r2 it becomes
# the bucket's public URL (the backend's R2_PUBLIC_URL).
#
# Whatever this is, its host must also be listed in next.config.ts under
# images.remotePatterns or next/image refuses to load from it.
NEXT_PUBLIC_MEDIA_URL=http://localhost:5000

# ─── Revalidation ────────────────────────────────────────────────────────────
# Shared secret the backend presents when a catalogue change should invalidate
# a cached page. Leave empty until the revalidate route handler exists.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ─── Third party (not wired yet) ─────────────────────────────────────────────
# CCM19 cookie banner — a launch requirement (spec §10.3). The client supplies
# the domain id.
# NEXT_PUBLIC_CCM19_DOMAIN_ID=
