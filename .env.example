# Copy to .env and fill in. Every value here is safe to commit — real secrets
# belong in .env, which is ignored.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who opens the site. Never put a secret behind that prefix.

# ─── API ─────────────────────────────────────────────────────────────────────
# The Express backend as reached from the browser. Must match one of the
# origins in the backend's CORS_ORIGINS, or every request is blocked.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Read by the browser AND by the server components that fetch product and
# category metadata, so on Vercel it must be the public API origin — there is
# no private network between a Vercel function and a Render service.

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin of the storefront. Feeds metadataBase, canonical URLs,
# hreflang alternates (en at /, de at /de/), sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ─── Marketing images ────────────────────────────────────────────────────────
# Nothing to configure. The photographs on the home page and the content pages
# were imported into the media library (backend/scripts/import-wp-media.ts) and
# are served from NEXT_PUBLIC_MEDIA_URL like every other image. The storefront
# makes no request to the old WordPress site any more.


# ─── Third party (not wired yet) ─────────────────────────────────────────────
# CCM19 cookie banner — a launch requirement (spec §10.3). The client supplies
# the domain id.
# NEXT_PUBLIC_CCM19_DOMAIN_ID=
